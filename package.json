    "start": "npm run server",
    "test": "node --test server/*.test.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "tailwindcss": "^4.1.0",
    "vite": "^7.0.0"
  }
}

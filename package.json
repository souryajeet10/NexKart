{
  "name": "smartcart-local",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "server": "node --env-file-if-exists=.env server/index.js",
    "client": "vite --config client/vite.config.js",

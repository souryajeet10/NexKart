HOST=127.0.0.1
PORT=3001
# Set a long unique value before enabling Hardware Mode.
SMARTCART_DEVICE_KEY=

# Bind one physical cart per backend/database. Must match firmware DEVICE_ID.
SMARTCART_DEVICE_ID=SC-01-ESP32
# Always disabled by NODE_ENV=production, regardless of this flag.
SMARTCART_SIMULATION=true
# Fresh production databases never receive demo tags.
SMARTCART_SEED_DEMO=true
# NODE_ENV=production
# SMARTCART_DB=data/smartcart.sqlite
